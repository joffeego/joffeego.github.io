---
import Icon from './Icon.astro';
---

<aside class="sidebar">
  <div class="profile">
    <a href="/about/" class="avatar-link">
      <img class="avatar" src="/images/avatar.jpg" alt="JoffeeGo 的头像" width="120" height="120" />
    </a>
    <p class="profile-bio" data-bio="技术 · 生活 · 思考">
      <span class="bio-text">技术 · 生活 · 思考</span><span class="bio-cursor" aria-hidden="true"></span>
    </p>
  </div>

  <script>
    const bio = document.querySelector('.profile-bio');
    const target = bio?.querySelector('.bio-text');
    const text = bio?.getAttribute('data-bio') ?? '';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (target && !reduced && text) {
      target.textContent = '';
      let i = 0;

      const tick = () => {
        i += 1;
        target.textContent = text.slice(0, i);
        if (i < text.length) {
          const ch = text[i - 1];
          // 自然节奏：标点停顿、空格更快、字符间略有随机
          const delay = ch === ' ' ? 50 : '·'.includes(ch) ? 320 : 90 + Math.random() * 80;
          window.setTimeout(tick, delay);
        }
      };

      window.setTimeout(tick, 500);
    }
  </script>

  <div class="social-links">
    <a href="https://github.com/joffeego" aria-label="GitHub" title="GitHub">
      <Icon name="github" size={18} />
    </a>
    <a href="/rss.xml" aria-label="RSS 订阅" title="RSS 订阅">
      <Icon name="rss" size={18} />
    </a>
  </div>

  <slot />
</aside>
