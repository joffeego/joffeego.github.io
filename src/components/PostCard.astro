---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { excerpt, formatDate, readingTime } from '../utils';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const summary = post.data.description ?? excerpt(post.body ?? '');
---

<article class="post-card">
  <header class="post-card-header">
    <h2 class="post-card-title">
      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
    </h2>
    <div class="post-meta">
      <span class="meta-item">
        <Icon name="calendar" />
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </span>
      {
        post.data.categories.length > 0 && (
          <>
            <span class="meta-divider">|</span>
            <span class="meta-item">
              <Icon name="folder" />
              {post.data.categories.map((c) => (
                <a href={`/categories/${encodeURIComponent(c)}/`}>{c}</a>
              ))}
            </span>
          </>
        )
      }
      <span class="meta-divider">|</span>
      <span class="meta-item">
        <Icon name="clock" />
        <span>约 {readingTime(post.body ?? '')} 分钟</span>
      </span>
    </div>
  </header>

  <div class="post-card-excerpt">
    <p>{summary}</p>
  </div>

  <div class="post-card-footer">
    <a class="read-more" href={`/blog/${post.id}/`}>阅读全文 »</a>
  </div>
</article>
