---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime, wordCount } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
  );
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      prev: i > 0 ? posts[i - 1] : null,
      next: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="post-full">
    <div class="paper">
      {post.data.cover && (
        <div class="post-cover">
          <img src={post.data.cover} alt={post.data.title} />
        </div>
      )}
      <header class="post-full-header">
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <div class="post-meta">
          <span class="meta-item">
            <Icon name="calendar" />
            <span>发表于</span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </span>
          {
            post.data.categories.length > 0 && (
              <>
                <span class="meta-divider">|</span>
                <span class="meta-item">
                  <Icon name="folder" />
                  <span>分类于</span>
                  {post.data.categories.map((c) => (
                    <a href={`/categories/${encodeURIComponent(c)}/`}>{c}</a>
                  ))}
                </span>
              </>
            )
          }
          <span class="meta-divider">|</span>
          <span class="meta-item">
            <Icon name="file" />
            <span>{wordCount(post.body ?? '')} 字</span>
          </span>
          <span class="meta-divider">|</span>
          <span class="meta-item">
            <Icon name="clock" />
            <span>约 {readingTime(post.body ?? '')} 分钟</span>
          </span>
        </div>
      </header>

      <div class="post-body" data-pagefind-body>
        <Content />
      </div>

      {
        post.data.tags.length > 0 && (
          <footer class="post-tags">
            {post.data.tags.map((t) => (
              <a class="post-tag" href={`/tags/${encodeURIComponent(t)}/`}>
                <Icon name="hash" size={12} />
                {t}
              </a>
            ))}
          </footer>
        )
      }
    </div>

    <nav class="post-nav">
      <div class="post-nav-item post-nav-prev">
        {
          prev && (
            <a href={`/blog/${prev.id}/`}>
              <Icon name="chevron-left" size={14} />
              <span>{prev.data.title}</span>
            </a>
          )
        }
      </div>
      <div class="post-nav-item post-nav-next">
        {
          next && (
            <a href={`/blog/${next.id}/`}>
              <span>{next.data.title}</span>
              <Icon name="chevron-right" size={14} />
            </a>
          )
        }
      </div>
    </nav>
  </article>

  {
    toc.length > 0 && (
      <nav class="toc-float" id="toc-float">
        <h3 class="toc-title">目录</h3>
        <div class="toc-list">
          <ol>
            {toc.map((h) => (
              <li class:list={[h.depth === 3 && 'toc-sub']}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )
  }
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toc = document.getElementById('toc-float');
    if (!toc) return;

    const tocList = toc.querySelector('.toc-list');
    const links = toc.querySelectorAll('a');
    const headings = [];
    links.forEach(link => {
      const id = link.getAttribute('href')?.slice(1);
      if (id) {
        const el = document.getElementById(id);
        if (el) headings.push({ el, link });
      }
    });

    if (headings.length === 0) return;

    // 阻止 TOC 上的滚轮事件冒泡到页面
    tocList.addEventListener('wheel', (e) => {
      e.stopPropagation();
    }, { passive: true });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          links.forEach(l => l.classList.remove('active'));
          const match = headings.find(h => h.el === entry.target);
          if (match) {
            match.link.classList.add('active');
            // 滚动 TOC 到可见位置
            const linkRect = match.link.getBoundingClientRect();
            const listRect = tocList.getBoundingClientRect();
            if (linkRect.top < listRect.top || linkRect.bottom > listRect.bottom) {
              match.link.scrollIntoView({ block: 'center', behavior: 'smooth' });
            }
          }
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });

    headings.forEach(h => observer.observe(h.el));

    window.addEventListener('scroll', () => {
      if (window.scrollY > 400) {
        toc.classList.add('show');
      } else {
        toc.classList.remove('show');
      }
    }, { passive: true });
  });
</script>
