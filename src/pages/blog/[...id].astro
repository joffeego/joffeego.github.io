---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime, wordCount } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
  );
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      prev: i > 0 ? posts[i - 1] : null,
      next: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="post-full">
    <div class="paper">
      {post.data.cover && (
        <div class="post-cover">
          <img src={post.data.cover} alt={post.data.title} />
        </div>
      )}
      <header class="post-full-header">
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <div class="post-meta">
          <span class="meta-item">
            <Icon name="calendar" />
            <span>发表于</span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </span>
          {
            post.data.categories.length > 0 && (
              <>
                <span class="meta-divider">|</span>
                <span class="meta-item">
                  <Icon name="folder" />
                  <span>分类于</span>
                  {post.data.categories.map((c) => (
                    <a href={`/categories/${encodeURIComponent(c)}/`}>{c}</a>
                  ))}
                </span>
              </>
            )
          }
          <span class="meta-divider">|</span>
          <span class="meta-item">
            <Icon name="file" />
            <span>{wordCount(post.body ?? '')} 字</span>
          </span>
          <span class="meta-divider">|</span>
          <span class="meta-item">
            <Icon name="clock" />
            <span>约 {readingTime(post.body ?? '')} 分钟</span>
          </span>
        </div>
      </header>

      <div class="post-body" data-pagefind-body>
        <Content />
      </div>

      {
        post.data.tags.length > 0 && (
          <footer class="post-tags">
            {post.data.tags.map((t) => (
              <a class="post-tag" href={`/tags/${encodeURIComponent(t)}/`}>
                <Icon name="hash" size={12} />
                {t}
              </a>
            ))}
          </footer>
        )
      }
    </div>

    <nav class="post-nav">
      <div class="post-nav-item post-nav-prev">
        {
          prev && (
            <a href={`/blog/${prev.id}/`}>
              <Icon name="chevron-left" size={14} />
              <span>{prev.data.title}</span>
            </a>
          )
        }
      </div>
      <div class="post-nav-item post-nav-next">
        {
          next && (
            <a href={`/blog/${next.id}/`}>
              <span>{next.data.title}</span>
              <Icon name="chevron-right" size={14} />
            </a>
          )
        }
      </div>
    </nav>
  </article>

  {
    toc.length > 0 && (
      <nav class="toc-float" id="toc-float">
        <h3 class="toc-title">目录</h3>
        <div class="toc-list">
          <ol>
            {toc.map((h) => (
              <li class:list={[h.depth === 3 && 'toc-sub']}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )
  }
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toc = document.getElementById('toc-float');
    if (!toc) return;

    const tocList = toc.querySelector('.toc-list');
    const links = toc.querySelectorAll('a');
    const headings = [];
    links.forEach(link => {
      const id = link.getAttribute('href')?.slice(1);
      if (id) {
        const el = document.getElementById(id);
        if (el) headings.push({ el, link });
      }
    });

    if (headings.length === 0) return;

    // 文章页目录常驻显示,进入即可点击
    toc.classList.add('show');

    // TOC 列表滚动:滚动只作用于目录列表本身,绝不带动文章页面
    tocList.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY;
      const max = tocList.scrollHeight - tocList.clientHeight;
      tocList.scrollTop = Math.min(Math.max(tocList.scrollTop + delta, 0), max);
    }, { passive: false });

    // 点击目录项时:立即高亮目标,并暂停自动高亮/列表滚动(等锚点滚动结束),
    // 避免跳转过程中高亮闪变、列表被程序滚动而丢失用户手动滚动的位置
    let suppressAuto = false;
    let suppressTimer = null;
    links.forEach(link => {
      link.addEventListener('click', () => {
        suppressAuto = true;
        links.forEach(l => l.classList.remove('active'));
        link.classList.add('active');
        clearTimeout(suppressTimer);
        suppressTimer = setTimeout(() => { suppressAuto = false; }, 1500);
      });
    });

    const observer = new IntersectionObserver(() => {
      if (suppressAuto) return;
      // 高亮视口内最靠上的标题(0 ~ 30% 处),排除已滚出视口上方的标题,
      // 避免点击跳转后上一节标题仍留在条带内导致高亮错位
      let best = null;
      let bestTop = Infinity;
      for (const h of headings) {
        const top = h.el.getBoundingClientRect().top;
        if (top >= 0 && top < window.innerHeight * 0.3 && top < bestTop) {
          bestTop = top;
          best = h;
        }
      }
      if (!best) return;
      links.forEach(l => l.classList.remove('active'));
      best.link.classList.add('active');
      // 手动滚动 TOC 列表让高亮项可见(不用 scrollIntoView,避免连带滚动文档)
      const linkRect = best.link.getBoundingClientRect();
      const listRect = tocList.getBoundingClientRect();
      if (linkRect.top < listRect.top || linkRect.bottom > listRect.bottom) {
        tocList.scrollTop += linkRect.top - listRect.top - (listRect.height - linkRect.height) / 2;
      }
    }, { rootMargin: '-80px 0px -70% 0px' });

    headings.forEach(h => observer.observe(h.el));
  });
</script>
