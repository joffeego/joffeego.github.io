---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime, wordCount } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
  );
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      prev: i > 0 ? posts[i - 1] : null, // 较早的一篇
      next: i < posts.length - 1 ? posts[i + 1] : null, // 较新的一篇
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<Base title={post.data.title} description={post.data.description}>
  {
    toc.length > 0 && (
      <nav class="toc" slot="sidebar">
        <h3 class="toc-title">文章目录</h3>
        <ol>
          {toc.map((h) => (
            <li class:list={[h.depth === 3 && 'toc-sub']}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <article class="post-full">
    <div class="paper">
      <header class="post-full-header">
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <span class="meta-item">
            <Icon name="calendar" />
            <span>发表于</span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </span>
          {
            post.data.categories.length > 0 && (
              <>
                <span class="meta-divider">|</span>
                <span class="meta-item">
                  <Icon name="folder" />
                  <span>分类于</span>
                  {post.data.categories.map((c) => (
                    <a href={`/categories/${encodeURIComponent(c)}/`}>{c}</a>
                  ))}
                </span>
              </>
            )
          }
          <span class="meta-divider">|</span>
          <span class="meta-item">
            <Icon name="file" />
            <span>{wordCount(post.body ?? '')} 字</span>
          </span>
          <span class="meta-divider">|</span>
          <span class="meta-item">
            <Icon name="clock" />
            <span>约 {readingTime(post.body ?? '')} 分钟</span>
          </span>
        </div>
      </header>

      <div class="post-body">
        <Content />
      </div>

      {
        post.data.tags.length > 0 && (
          <footer class="post-tags">
            {post.data.tags.map((t) => (
              <a class="post-tag" href={`/tags/${encodeURIComponent(t)}/`}>
                <Icon name="hash" size={12} />
                {t}
              </a>
            ))}
          </footer>
        )
      }
    </div>

    <nav class="post-nav">
      <div class="post-nav-item post-nav-prev">
        {
          prev && (
            <a href={`/blog/${prev.id}/`}>
              <Icon name="chevron-left" size={14} />
              <span>{prev.data.title}</span>
            </a>
          )
        }
      </div>
      <div class="post-nav-item post-nav-next">
        {
          next && (
            <a href={`/blog/${next.id}/`}>
              <span>{next.data.title}</span>
              <Icon name="chevron-right" size={14} />
            </a>
          )
        }
      </div>
    </nav>
  </article>
</Base>
