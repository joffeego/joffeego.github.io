---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = '技术 · 生活 · 思考' } = Astro.props;
const pageTitle = title ? `${title} · JoffeeGo` : "JoffeeGo's Blog";
const year = new Date().getFullYear();

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '首页', icon: 'home', match: (p: string) => p === '/' || p.startsWith('/blog/') },
  { href: '/categories/', label: '分类', icon: 'folder', match: (p: string) => p.startsWith('/categories/') },
  { href: '/archives/', label: '归档', icon: 'archive', match: (p: string) => p.startsWith('/archives/') },
  { href: '/tags/', label: '标签', icon: 'tag', match: (p: string) => p.startsWith('/tags/') },
  { href: '/about/', label: '关于', icon: 'user', match: (p: string) => p.startsWith('/about/') },
] as const;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="JoffeeGo's Blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="stylesheet" href="/fonts/maple-mono/MapleMono-CN-Regular/result.css" />
    <link rel="stylesheet" href="/fonts/maple-mono/MapleMono-CN-Bold/result.css" />
    <title>{pageTitle}</title>
    <script is:inline>
      // 主题初始化:优先读取用户选择,否则跟随系统(提前执行避免闪烁)
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'dark' && t !== 'light') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-brand">
        <a href="/" class="brand">
          <span class="logo-line" aria-hidden="true"></span>
          <span class="site-title">JoffeeGo's Blog</span>
          <span class="logo-line" aria-hidden="true"></span>
        </a>
      </div>
      <nav class="site-nav">
        {
          nav.map((item) => (
            <a href={item.href} class:list={['nav-link', { active: item.match(path) }]}>
              <Icon name={item.icon} size={13} />
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
    </header>

    <div class="layout">
      <Sidebar>
        <slot name="sidebar" />
      </Sidebar>

      <main class="content">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <p>© {year} JoffeeGo · 与你一起发现更大的世界</p>
      <p class="footer-sub">
        由 <a href="https://astro.build">Astro</a> 强力驱动 ·
        <a href="/rss.xml">RSS 订阅</a>
      </p>
    </footer>

    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换深色/浅色主题" title="切换主题">
      <svg class="theme-icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="theme-icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    </button>

    <button class="search-fab" id="search-fab" aria-label="搜索文章">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </button>

    <button class="back-to-top" id="back-to-top" aria-label="回到顶部">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>

    <div class="search-modal" id="search-modal">
      <div class="search-modal-backdrop" id="search-backdrop"></div>
      <div class="search-modal-content">
        <div id="search-container"></div>
        <button class="search-modal-close" id="search-close" aria-label="关闭搜索">
          <kbd>ESC</kbd>
        </button>
      </div>
    </div>

    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script is:inline src="/pagefind/pagefind-ui.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 主题切换:用 View Transitions 做"新主题从按钮位置圆形展开"动画,
        // 内容是页面快照(全程可见),不会出现先全黑/全白再切换的遮罩
        const themeBtn = document.getElementById('theme-toggle');
        const getTheme = () =>
          document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        const applyTheme = (theme) => {
          document.documentElement.setAttribute('data-theme', theme);
          try { localStorage.setItem('theme', theme); } catch (e) {}
        };
        let themeAnimating = false;
        themeBtn.addEventListener('click', () => {
          if (themeAnimating) return;
          const next = getTheme() === 'dark' ? 'light' : 'dark';
          const rect = themeBtn.getBoundingClientRect();
          const x = rect.left + rect.width / 2;
          const y = rect.top + rect.height / 2;
          document.documentElement.style.setProperty('--theme-reveal-x', `${x}px`);
          document.documentElement.style.setProperty('--theme-reveal-y', `${y}px`);
          themeAnimating = true;
          const finish = () => { themeAnimating = false; };
          if (document.startViewTransition) {
            document.startViewTransition(() => applyTheme(next)).finished.then(finish).catch(finish);
          } else {
            applyTheme(next);
            finish();
          }
        });

        const fab = document.getElementById('search-fab');
        const modal = document.getElementById('search-modal');
        const backdrop = document.getElementById('search-backdrop');
        const closeBtn = document.getElementById('search-close');
        const container = document.getElementById('search-container');
        const backToTop = document.getElementById('back-to-top');
        let loaded = false;

        function openSearch() {
          modal.classList.add('open');
          if (!loaded) {
            new PagefindUI({ element: container, showSubResults: true });
            loaded = true;
          }
          setTimeout(() => container.querySelector('input')?.focus(), 100);
        }

        function closeSearch() {
          modal.classList.remove('open');
        }

        fab.addEventListener('click', openSearch);
        backdrop.addEventListener('click', closeSearch);
        closeBtn.addEventListener('click', closeSearch);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeSearch();
          if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            openSearch();
          }
        });

        // 回到顶部按钮：滚动超过 300px 显示
        window.addEventListener('scroll', () => {
          if (window.scrollY > 300) {
            backToTop.classList.add('show');
          } else {
            backToTop.classList.remove('show');
          }
        }, { passive: true });

        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // 代码块一键复制
        document.querySelectorAll('pre').forEach(pre => {
          const btn = document.createElement('button');
          btn.className = 'code-copy-btn';
          btn.textContent = '复制';
          btn.addEventListener('click', () => {
            const code = pre.querySelector('code')?.textContent ?? pre.textContent;
            navigator.clipboard.writeText(code).then(() => {
              btn.textContent = '已复制';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.textContent = '复制';
                btn.classList.remove('copied');
              }, 1500);
            });
          });
          pre.style.position = 'relative';
          pre.appendChild(btn);
        });
      });
    </script>
  </body>
</html>
