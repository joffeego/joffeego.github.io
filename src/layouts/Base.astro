---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = '技术 · 生活 · 思考' } = Astro.props;
const pageTitle = title ? `${title} · JoffeeGo` : 'JoffeeGo 的博客';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="JoffeeGo 的博客" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">JoffeeGo</a>
      <nav>
        <a href="/">文章</a>
        <a href="/about/">关于</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>© {year} JoffeeGo</span>
      <span class="footer-dot">·</span>
      <a href="https://github.com/joffeego">GitHub</a>
    </footer>
  </body>
</html>
