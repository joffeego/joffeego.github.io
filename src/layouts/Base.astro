---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = '技术 · 生活 · 思考' } = Astro.props;
const pageTitle = title ? `${title} · JoffeeGo` : "JoffeeGo's Blog";
const year = new Date().getFullYear();

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '首页', icon: 'home', match: (p: string) => p === '/' || p.startsWith('/blog/') },
  { href: '/categories/', label: '分类', icon: 'folder', match: (p: string) => p.startsWith('/categories/') },
  { href: '/archives/', label: '归档', icon: 'archive', match: (p: string) => p.startsWith('/archives/') },
  { href: '/tags/', label: '标签', icon: 'tag', match: (p: string) => p.startsWith('/tags/') },
  { href: '/about/', label: '关于', icon: 'user', match: (p: string) => p.startsWith('/about/') },
] as const;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="JoffeeGo's Blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lato-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-brand">
        <a href="/" class="brand">
          <span class="logo-line" aria-hidden="true"></span>
          <span class="site-title">JoffeeGo's Blog</span>
          <span class="logo-line" aria-hidden="true"></span>
        </a>
      </div>
      <nav class="site-nav">
        {
          nav.map((item) => (
            <a href={item.href} class:list={['nav-link', { active: item.match(path) }]}>
              <Icon name={item.icon} size={13} />
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
    </header>

    <div class="layout">
      <Sidebar>
        <slot name="sidebar" />
      </Sidebar>

      <main class="content">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <p>© {year} JoffeeGo · 与你一起发现更大的世界</p>
      <p class="footer-sub">
        由 <a href="https://astro.build">Astro</a> 强力驱动 ·
        <a href="/rss.xml">RSS 订阅</a>
      </p>
    </footer>
  </body>
</html>
